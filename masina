local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local player = Players.LocalPlayer
local lobbyId = 125810438250765
local undergroundId = 93044798454681
local lobbyScriptUrl = "https://raw.githubusercontent.com/87987mdsa/asdasdsa/refs/heads/main/kk"
local undergroundScriptUrl = "https://raw.githubusercontent.com/87987mdsa/optz/refs/heads/main/optzzser"
local queueteleport = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
local TeleportCheck = false

local function autoExecute()
    task.wait(3)    
    if game.PlaceId == lobbyId then
        if queueteleport then
            queueteleport('loadstring(game:HttpGet("' .. lobbyScriptUrl .. '"))()')
        else
            loadstring(game:HttpGet(lobbyScriptUrl))()
        end
        task.wait(2)
        TeleportService:Teleport(undergroundId, player)
    elseif game.PlaceId == undergroundId then
        loadstring(game:HttpGet(undergroundScriptUrl))()
    end
end

autoExecute()
player.CharacterAdded:Connect(autoExecute)
if queueteleport then
    queueteleport([[

        loadstring(game:HttpGet('https://raw.githubusercontent.com/87987mdsa/asdasdsa2/refs/heads/main/masina'))()
    ]])
end

player.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Started and not TeleportCheck then
        TeleportCheck = true
    end
end)
