local Players = game:GetService("Players")
local lobbyId = 125810438250765
local undergroundId = 93044798454681

local scriptLoaded = false

local player = Players.LocalPlayer
while not player do
    player = Players.LocalPlayer
    task.wait()
end

if not scriptLoaded then
    task.wait(2)
    if game.PlaceId == lobbyId then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/87987mdsa/asdasdsa/refs/heads/main/kk"))()
        scriptLoaded = true
    elseif game.PlaceId == undergroundId then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/87987mdsa/testttt/refs/heads/main/sadz"))()
        scriptLoaded = true
    end
end

player.CharacterAdded:Connect(function()
    scriptLoaded = false
    task.wait(1)

    if game.PlaceId == lobbyId then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/87987mdsa/asdasdsa/refs/heads/main/kk"))()
        scriptLoaded = true

    elseif game.PlaceId == undergroundId then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/87987mdsa/testttt/refs/heads/main/sadz"))()
        scriptLoaded = true
    end
end)
